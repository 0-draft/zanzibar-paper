---
import { LANGS, TRANSLATIONS } from "../i18n/langs.ts";
import { UI } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { loadSource, loadTranslation } from "../lib/content.ts";
import { allEntries, inSection, pathOf, splitId } from "../lib/guides.ts";
import { REPO_URL, withBase } from "../lib/paths.ts";

const src = loadSource();
const titles: Record<string, string> = {
  ...Object.fromEntries(TRANSLATIONS.map((l) => [l.code, loadTranslation(l.code).meta.title])),
  en: "The original alone, without a translation",
};
// The translations first, then the original on its own.
const listed = [...TRANSLATIONS, ...LANGS.filter((l) => l.code === "en")];
const codes = listed.map((l) => l.code);
const en = UI.en!;
const entries = await allEntries();
const guides = inSection(entries, "en", "guides");
const systems = inSection(entries, "en", "ecosystem");
---

<Base lang="en" title={`${src.meta.title} | read side by side`} description={en.description} path="" alternates>
  <main class="landing">
    <p class="tuple-hero" lang="en">
      <span class="t">paper<span class="p">:</span>zanzibar<span class="p">#</span>translation<span class="at"><span class="p">@</span><span class="u">you</span></span></span>
    </p>

    <h1 class="landing-title">{src.meta.title}</h1>
    <p class="landing-sub">
      Pang et al., {src.meta.venue.replace("Proc. of ", "")}. Read paragraph by paragraph, the original English next to one of
      eight translations.
    </p>

    <ul class="landing-langs">
      {
        listed.map((l) => (
          <li data-code={l.code}>
            <a href={withBase(`${l.code}/`)} hreflang={l.code}>
              <span class="native" lang={l.code}>
                {l.native}
              </span>
              <span class="ttl" lang={l.code}>
                {titles[l.code]}
              </span>
              <span class="hint">matches your browser</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="landing-more">
      <section>
        <h2><a href={withBase(pathOf("en", "guides"))}>{en.navGuides}</a></h2>
        <p>{en.guidesLead}</p>
        <ul>
          {
            guides.map((g) => (
              <li>
                <a href={withBase(pathOf("en", "guides", splitId(g.id).slug))}>{g.data.title}</a>
              </li>
            ))
          }
        </ul>
      </section>
      <section>
        <h2><a href={withBase(pathOf("en", "ecosystem"))}>{en.navEcosystem}</a></h2>
        <p>{en.ecosystemLead}</p>
        <ul>
          {
            systems.map((g) => (
              <li>
                <a href={withBase(pathOf("en", "ecosystem", splitId(g.id).slug))}>{g.data.title}</a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <p class="landing-links">
      <a href={src.meta.source.usenix} rel="noopener" target="_blank">The original paper at USENIX</a>
      <a href={REPO_URL} rel="noopener" target="_blank">Source and issues on GitHub</a>
    </p>
    <p class="landing-notice">{en.notice} {en.aiNote}</p>
  </main>

  <script is:inline define:vars={{ codes }}>
    // Mark the translation that matches the browser's languages. Never
    // redirects: the list stays the page, so links and crawlers see every
    // translation.
    const prefs = navigator.languages || [navigator.language];
    let pick;
    for (const p of prefs) {
      const lower = String(p).toLowerCase();
      pick =
        codes.find((c) => c.toLowerCase() === lower) ||
        (lower.startsWith("zh") && (/(hant|tw|hk|mo)/.test(lower) ? "zh-Hant" : "zh-Hans")) ||
        (lower.startsWith("pt") && "pt-BR") ||
        codes.find((c) => c.toLowerCase() === lower.split("-")[0]);
      if (pick) break;
    }
    if (pick) document.querySelector(`[data-code="${pick}"]`)?.classList.add("suggested");
  </script>
</Base>

<style>
  .landing {
    max-width: 58rem;
    margin-inline: auto;
    padding-block: clamp(3rem, 9vw, 6.5rem) 4rem;
  }
  .landing-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    line-height: 1.2;
    margin: 2.25rem 0 0.75rem;
    padding-top: 1.75rem;
    border-top: 2px solid var(--rule-strong);
    text-wrap: balance;
  }
  .landing-sub {
    margin: 0 0 2.25rem;
    color: var(--ink-2);
    font-family: var(--serif);
    max-width: 44rem;
  }
  .landing-langs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .landing-langs a {
    display: grid;
    grid-template-columns: 11rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0.6rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }
  .landing-langs a:hover {
    background: var(--server);
  }
  .landing-langs .native {
    font-weight: 600;
  }
  .landing-langs .ttl {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .landing-langs .hint {
    display: none;
    font-size: 0.78rem;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .landing-langs .suggested a {
    box-shadow: inset 3px 0 0 var(--link);
  }
  .landing-langs .suggested .hint {
    display: inline;
  }
  .landing-more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2rem 3rem;
    margin-top: 3rem;
  }
  .landing-more h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .landing-more p {
    margin: 0 0 0.75rem;
    color: var(--ink-2);
    font-size: var(--fs-s);
  }
  .landing-more ul {
    margin: 0;
    padding-left: 1.2em;
  }
  .landing-more li + li {
    margin-top: 0.35rem;
  }
  .landing-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 2rem;
  }
  .landing-notice {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--ink-2);
    max-width: 48rem;
  }
  @media (max-width: 40rem) {
    .landing-langs a {
      grid-template-columns: 1fr auto;
    }
    .landing-langs .ttl {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
