---
import LangMenu from "../../components/LangMenu.astro";
import Toc from "../../components/Toc.astro";
import { getLang, TRANSLATIONS } from "../../i18n/langs.ts";
import { ui } from "../../i18n/ui.ts";
import Base from "../../layouts/Base.astro";
import { loadSource, loadTranslation } from "../../lib/content.ts";
import { issueUrl, REPO_URL, withBase } from "../../lib/paths.ts";
import { buildRows, buildToc } from "../../lib/render.ts";

export function getStaticPaths() {
  return TRANSLATIONS.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: string };
const L = getLang(lang);
const t = ui(lang);
const src = loadSource();
const tr = loadTranslation(lang);
const base = withBase();
const rows = buildRows(src, tr, base);
const toc = buildToc(src, tr);
const m = src.meta;
const pageTitle = `${tr.meta.title} | ${m.title}`;
---

<Base lang={lang} title={pageTitle} description={t.description} path={`${lang}/`} alternates>
  <a class="skip" href="#paper">{t.skip}</a>

  <header class="bar">
    <a class="brand" href={base} lang="en">zanzibar-paper</a>
    <div class="bar-tools">
      <details class="toc-pop">
        <summary>{t.contents}</summary>
        <div class="toc-pop-panel"><Toc entries={toc} label={t.contents} lang={lang} /></div>
      </details>
      <LangMenu current={lang} label={t.language} display="name" class="bar-lang" />
      <div class="seg" role="group" aria-label={t.view} data-js-only hidden>
        <button type="button" data-set-view="both" aria-pressed="true">{t.viewBoth}</button>
        <button type="button" data-set-view="original" aria-pressed="false">{t.viewOriginal}</button>
        <button type="button" data-set-view="translation" aria-pressed="false">{t.viewTranslation}</button>
      </div>
      <label class="view-select" data-js-only hidden>
        <span class="vh">{t.view}</span>
        <select data-view-select>
          <option value="both">{t.viewBoth}</option>
          <option value="original">{t.viewOriginal}</option>
          <option value="translation">{t.viewTranslation}</option>
        </select>
      </label>
      <label class="theme" data-js-only hidden>
        <span class="vh">{t.theme}</span>
        <select data-theme-select>
          <option value="system">{t.themeSystem}</option>
          <option value="light">{t.themeLight}</option>
          <option value="dark">{t.themeDark}</option>
        </select>
      </label>
    </div>
  </header>

  <main id="paper" data-lang={lang}>
    <header class="masthead">
      <div class="tuple-wrap">
        <div class="tuple" lang="en">
          <span class="seg-ns" title={t.tupleParts.namespace}>paper</span><span class="punct">:</span><span
            class="seg-obj"
            title={t.tupleParts.object}>zanzibar</span
          ><span class="punct">#</span><span class="seg-rel" title={t.tupleParts.relation}>translation</span><span
            class="punct">@</span
          ><LangMenu current={lang} label={t.language} display="code" class="seg-user" />
        </div>
        <p class="tuple-caption">
          {t.tupleCaption}
          <span class="legend">
            <span class="k k-ns">{t.tupleParts.namespace}</span>
            <span class="k k-obj">{t.tupleParts.object}</span>
            <span class="k k-rel">{t.tupleParts.relation}</span>
            <span class="k k-user">{t.tupleParts.user}</span>
          </span>
        </p>
      </div>

      <div class="title-row">
        <p class="title-en" lang="en">{m.title}</p>
        <h1 class="title-tr" lang={lang}>{tr.meta.title}</h1>
      </div>

      <div class="byline" lang="en">
        <p class="authors">
          {
            m.authors.map((a, i) => (
              <>
                <span class="author">
                  {a.name}
                  <sup>
                    {a.aff.join(",")}
                    {a.note ? "∗" : ""}
                  </sup>
                </span>
                {i < m.authors.length - 1 ? ", " : ""}
              </>
            ))
          }
        </p>
        <p class="affs">
          {
            m.affiliations.map((a, i) => (
              <span>
                <sup>{i + 1}</sup>
                {a}
              </span>
            ))
          }
        </p>
        <p class="venue">{m.venue}</p>
      </div>

      <div class="provenance">
        <p class="links">
          <a href={m.source.usenix} rel="noopener" target="_blank">{t.readOriginal} (USENIX)</a>
          <a href={m.source.google} rel="noopener" target="_blank">Google Research</a>
        </p>
        <p class="notice">{t.notice}</p>
        <p class="notice">{t.aiNote} <a href={issueUrl(lang)} rel="noopener" target="_blank">{t.fixLink}</a></p>
      </div>
    </header>

    <div class="colheads" aria-hidden="true">
      <span class="ch-en"><span class="ch-role">{t.original}</span><span class="ch-name" lang="en">English</span></span>
      <span class="ch-tr"><span class="ch-role" lang={lang}>{t.translation}</span></span>
    </div>

    <div class="layout">
      <aside class="rail"><Toc entries={toc} label={t.contents} lang={lang} /></aside>

      <article class="paper" data-script={L.script}>
        {
          rows.map((r) => (
            <div id={r.id} class:list={["row", `row-${r.type}`, r.shared !== undefined && "has-shared"]}>
              {r.shared !== undefined && <div class="shared" set:html={r.shared} />}
              {r.en !== undefined && <div class="cell cell-en" lang="en" set:html={r.en} />}
              {r.tr !== undefined && <div class="cell cell-tr" lang={lang} set:html={r.tr} />}
              <a class="pl" href={`#${r.id}`} aria-label={`${t.permalink} (${r.id})`}>
                ¶
              </a>
            </div>
          ))
        }
      </article>
    </div>
  </main>

  <footer class="foot">
    <p class="notice">{t.notice}</p>
    <p>
      <a href={REPO_URL} rel="noopener" target="_blank">{t.sourceCode}</a>
      <a href={issueUrl(lang)} rel="noopener" target="_blank">{t.fixLink}</a>
      <a href="#paper">{t.backToTop}</a>
    </p>
    <p class="other-langs" lang="en">
      {
        TRANSLATIONS.filter((l) => l.code !== lang).map((l) => (
          <a href={withBase(`${l.code}/`)} hreflang={l.code} lang={l.code}>
            {l.native}
          </a>
        ))
      }
    </p>
  </footer>

  <script>
    import "../../scripts/reader.ts";
  </script>
</Base>
