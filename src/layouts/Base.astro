---
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { TRANSLATIONS } from "../i18n/langs.ts";
import { withBase } from "../lib/paths.ts";

interface Props {
  lang: string;
  title: string;
  description: string;
  /** Path below the base, e.g. "ja/". Used for canonical and hreflang links. */
  path: string;
  alternates?: boolean;
  /** Error pages: no canonical URL, not indexed */
  noindex?: boolean;
}
const { lang, title, description, path, alternates = false, noindex = false } = Astro.props;
const site = Astro.site!;
const abs = (p: string) => new URL(withBase(p), site).href;
---

<!doctype html>
<html lang={lang} data-view="both" data-layout="side">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={abs(path)} />}
    {
      alternates &&
        TRANSLATIONS.map((l) => <link rel="alternate" hreflang={l.code} href={abs(`${l.code}/`)} />)
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={abs("")} />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={abs(path)} />}
    <meta property="og:image" content={abs("og.png")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={withBase("sitemap-index.xml")} />
    <slot name="head" />
    <script is:inline>
      // Apply saved reading preferences before first paint (no flash).
      // Narrow screens always stack the pair; reader.ts keeps this in sync.
      (() => {
        const d = document.documentElement;
        const get = (k) => {
          try {
            return localStorage.getItem(k);
          } catch {
            return null;
          }
        };
        const t = get("zp-theme");
        if (t === "light" || t === "dark") d.dataset.theme = t;
        const v = get("zp-view");
        if (v === "both" || v === "original" || v === "translation") d.dataset.view = v;
        const narrow = matchMedia("(max-width: 56rem)").matches;
        d.dataset.layout = narrow || get("zp-layout") === "stacked" ? "stacked" : "side";
        const z = get("zp-size");
        if (z === "s" || z === "l") d.dataset.size = z;
        const f = get("zp-first");
        if (f === "translation" || f === "original") d.dataset.first = f;
        d.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
