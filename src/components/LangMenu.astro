---
// A disclosure of plain links to every language version of the current page:
// works without JS and is crawlable. reader.ts carries the current paragraph
// over as #hash on click (paper pages).
import { LANGS, type Lang, TRANSLATIONS } from "../i18n/langs.ts";
import { withBase } from "../lib/paths.ts";

interface Props {
  current: string;
  label: string;
  class?: string;
  /** Path of this page in another language, below the base. Default: the paper page. */
  pathFor?: (code: string) => string;
  /** Which languages to list. Default: the eight translations. */
  langs?: readonly Lang[];
}
const { current, label, class: cls, pathFor = (code: string) => `${code}/`, langs = TRANSLATIONS } = Astro.props;
const cur = LANGS.find((l) => l.code === current)!;
---

<details class:list={["langmenu", cls]}>
  <summary>
    <span class="vh">{label}: </span>
    <span lang={cur.code} class="only-wide">{cur.native}</span><span lang="en" class="only-narrow">{cur.code}</span>
    <svg class="chev" viewBox="0 0 10 6" aria-hidden="true" width="10" height="6"
      ><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg
    >
  </summary>
  <ul class="pop-panel langmenu-list">
    {
      langs.map((l) => (
        <li>
          <a
            href={withBase(pathFor(l.code))}
            hreflang={l.code}
            aria-current={l.code === current ? "page" : undefined}
            data-lang-link
          >
            <span class="native" lang={l.code}>
              {l.native}
            </span>
            <span class="code" lang="en">
              {l.code}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</details>
