---
// A disclosure of plain links to every translation: works without JS and is
// crawlable. reader.ts carries the current paragraph over as #hash on click.
import { TRANSLATIONS } from "../i18n/langs.ts";
import { withBase } from "../lib/paths.ts";

interface Props {
  current: string;
  label: string;
  /** What the closed summary shows */
  display: "code" | "name";
  class?: string;
}
const { current, label, display, class: cls } = Astro.props;
const cur = TRANSLATIONS.find((l) => l.code === current)!;
---

<details class:list={["langmenu", cls]}>
  <summary>
    <span class="vh">{label}: </span>
    <span class="langmenu-value">{display === "code" ? cur.code : cur.native}</span>
    <svg class="chev" viewBox="0 0 10 6" aria-hidden="true" width="10" height="6"
      ><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg
    >
  </summary>
  <ul class="langmenu-list">
    {
      TRANSLATIONS.map((l) => (
        <li>
          <a
            href={withBase(`${l.code}/`)}
            hreflang={l.code}
            lang={l.code}
            aria-current={l.code === current ? "page" : undefined}
            data-lang-link
          >
            <span class="code">{l.code}</span>
            <span class="native">{l.native}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>
