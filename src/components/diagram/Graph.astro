---
import { labelSize, placeLabel, textWidth } from "./place.ts";
// Boxes and arrows, drawn in the palette of the paper's Figure 2:
//   client (blue) · server (yellow) · store (green) · subject / object (plain)
// Arrows stop at box edges; labels sit on a halo of the page colour so a line
// never runs through text. The geometry is the same in every language: only
// the labels change, so a page passes its own labels in.
//
// Usage in MDX:
//   <Graph width={560} height={240} title="…" desc="…"
//     nodes={[{ id: "u", x: 80, y: 120, label: "user:anne", kind: "subject", mono: true }, …]}
//     edges={[{ from: "u", to: "g", label: "member" }, …]} />

export interface GraphNode {
  id: string;
  /** Centre of the box, in viewBox units */
  x: number;
  y: number;
  w?: number;
  h?: number;
  /** "\n" breaks lines */
  label: string;
  kind?: "client" | "server" | "store" | "subject" | "object" | "group" | "note";
  mono?: boolean;
  /** Draw attention: a heavier outline in the link colour */
  on?: boolean;
}
export interface GraphEdge {
  from: string;
  to: string;
  label?: string;
  dashed?: boolean;
  /** "forward" (default), "both" or "none" */
  dir?: "forward" | "both" | "none";
  on?: boolean;
  /** Shift the label along the normal of the line (px) */
  labelOffset?: number;
}
export interface GraphGroup {
  /** Top-left corner and size, in viewBox units */
  x: number;
  y: number;
  w: number;
  h: number;
  /** Drawn at the top-left inside the frame */
  label?: string;
}
interface Props {
  width: number;
  height: number;
  title: string;
  desc: string;
  nodes: GraphNode[];
  edges?: GraphEdge[];
  /** Dashed frames drawn behind the nodes, e.g. "Spanner" or "serving cluster" */
  groups?: GraphGroup[];
  /** Phones: keep at least this many CSS px and scroll sideways */
  minWidth?: number;
  caption?: string;
}

const { width, height, title, desc, nodes, edges = [], groups = [], minWidth, caption } = Astro.props;
// stable across builds: derived from the figure's own title
const uid = `g${[...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7).toString(36)}`;
const byId = new Map(nodes.map((n) => [n.id, n]));

const size = (n: GraphNode) => {
  const lines = n.label.split("\n");
  const longest = Math.max(...lines.map((l) => textWidth(l, n.mono)));
  const w = n.w ?? Math.max(64, longest + 24);
  const h = n.h ?? 16 * lines.length + 16;
  return { w, h, lines };
};

/** Where the line from the centre of n towards (dx, dy) leaves the box. */
const exit = (n: GraphNode, dx: number, dy: number, gap: number) => {
  const { w, h } = size(n);
  const tx = dx === 0 ? Number.POSITIVE_INFINITY : (w / 2 + gap) / Math.abs(dx);
  const ty = dy === 0 ? Number.POSITIVE_INFINITY : (h / 2 + gap) / Math.abs(dy);
  const t = Math.min(tx, ty);
  return { x: n.x + dx * t, y: n.y + dy * t };
};

// every box, for keeping edge labels off them
const boxes = nodes.map((n) => {
  const { w, h } = size(n);
  return { x: n.x - w / 2, y: n.y - h / 2, w, h };
});

// The drawing area grows to take in any box that pokes past the given size,
// so a long label never clips at the edge.
const minX = Math.min(0, ...boxes.map((b) => b.x - 6));
const minY = Math.min(0, ...boxes.map((b) => b.y - 6));
const vw = Math.max(width, ...boxes.map((b) => b.x + b.w + 6)) - minX;
const vh = Math.max(height, ...boxes.map((b) => b.y + b.h + 6)) - minY;

const lines = edges.map((e) => {
  const a = byId.get(e.from);
  const b = byId.get(e.to);
  if (!a || !b) throw new Error(`Graph: unknown node in edge ${e.from} → ${e.to}`);
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  const dir = e.dir ?? "forward";
  const p = exit(a, ux, uy, dir === "both" ? 4 : 2);
  const q = exit(b, -ux, -uy, dir === "none" ? 2 : 4);
  const off = e.labelOffset ?? 0;
  const plate = e.label ? labelSize(e.label) : { w: 0, h: 0 };
  const at = { x: (p.x + q.x) / 2 - uy * off, y: (p.y + q.y) / 2 + ux * off };
  const spot = e.label
    ? placeLabel(
        at,
        { ux, uy, len: Math.hypot(q.x - p.x, q.y - p.y) },
        plate,
        boxes,
        {
          x: 0,
          y: 0,
          w: width,
          h: height,
        },
        `${e.label} (${title})`,
      )
    : at;
  return {
    ...e,
    dir,
    x1: p.x,
    y1: p.y,
    x2: q.x,
    y2: q.y,
    lx: spot.x,
    ly: spot.y,
    lw: plate.w,
    lh: plate.h,
  };
});
---

<figure class="dg" style={minWidth ? `--dg-min: ${minWidth}px` : undefined}>
  <div class="dg-scroll">
    <svg
      viewBox={`${minX} ${minY} ${vw} ${vh}`}
      width={vw}
      height={vh}
      role="img"
      aria-labelledby={`${uid}-t ${uid}-d`}
    >
      <title id={`${uid}-t`}>{title}</title>
      <desc id={`${uid}-d`}>{desc}</desc>
      <defs>
        <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" class="dg-head"></path>
        </marker>
        <marker id={`${uid}-ah`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" class="dg-head on"></path>
        </marker>
      </defs>
      {
        groups.map((g) => (
          <g class="dg-group">
            <rect x={g.x} y={g.y} width={g.w} height={g.h} rx={8} />
            {g.label && (
              <text x={g.x + 10} y={g.y + 16} class="dg-group-label">
                {g.label}
              </text>
            )}
          </g>
        ))
      }
      {
        lines.map((l) => (
          <line
            x1={l.x1}
            y1={l.y1}
            x2={l.x2}
            y2={l.y2}
            class:list={["dg-edge", l.dashed && "dashed", l.on && "on"]}
            marker-end={l.dir !== "none" ? `url(#${uid}-${l.on ? "ah" : "a"})` : undefined}
            marker-start={l.dir === "both" ? `url(#${uid}-${l.on ? "ah" : "a"})` : undefined}
          />
        ))
      }
      {
        nodes.map((n) => {
          const { w, h, lines: ls } = size(n);
          return (
            <g class:list={["dg-node", `k-${n.kind ?? "object"}`, n.on && "on"]}>
              {n.kind !== "note" && <rect x={n.x - w / 2} y={n.y - h / 2} width={w} height={h} rx={n.kind === "subject" ? h / 2 : 6} />}
              {ls.map((t, i) => (
                <text
                  x={n.x}
                  y={n.y + (i - (ls.length - 1) / 2) * 16}
                  dominant-baseline="central"
                  text-anchor="middle"
                  class:list={[n.mono && "mono"]}
                >
                  {t}
                </text>
              ))}
            </g>
          );
        })
      }
      {
        lines
          .filter((l) => l.label)
          .map((l) => {
            // A plate of the page colour behind the label, so the line never shows
            // through it, spaces included (a stroke halo leaves gaps there).
            return (
            <>
            <rect x={l.lx - l.lw / 2} y={l.ly - l.lh / 2} width={l.lw} height={l.lh} rx={3} class="dg-label-bg" />
            <text x={l.lx} y={l.ly} dominant-baseline="central" text-anchor="middle" class:list={["dg-label", l.on && "on"]}>
              {l.label!.split("\n").map((t, i, all) => (
                <tspan x={l.lx} dy={i === 0 ? `${-(all.length - 1) * 0.6}em` : "1.2em"}>
                  {t}
                </tspan>
              ))}
            </text>
            </>
            );
          })
      }
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
